      <_ATGFXCVer Condition="'$(_ATGFXCVer)' != '' and !HasTrailingSlash('$(_ATGFXCVer)')">$(_ATGFXCVer)\</_ATGFXCVer>
      <_ATGShaderOutDir>$(IntDir)Shaders\Compiled</_ATGShaderOutDir>
    </PropertyGroup>
    <Exec Condition="!Exists('$(_ATGShaderOutDir)\SpriteEffect_SpriteVertexShader.inc')" WorkingDirectory="$(SolutionDir)external\DirectXTK\Src\Shaders" Command="CompileShaders" EnvironmentVariables="WindowsSdkVerBinPath=$(_ATGFXCPath);WindowsSDKVersion=$(_ATGFXCVer);CompileShadersOutput=$(_ATGShaderOutDir)" LogStandardErrorAsError="true" />
    <PropertyGroup>
      <_ATGFXCPath />
      <_ATGFXCVer />
      <_ATGShaderOutDir />
    </PropertyGroup>
  </Target>
  <Target Name="ATGDeleteShaders" AfterTargets="Clean">
    <PropertyGroup>
      <_ATGShaderOutDir>$(IntDir)Shaders\Compiled</_ATGShaderOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_ATGShaderHeaders Include="$(_ATGShaderOutDir)\*.inc" Exclude="$(_ATGShaderOutDir)\*Xbox*.inc" />
      <_ATGShaderSymbols Include="$(_ATGShaderOutDir)\*.pdb" Exclude="$(_ATGShaderOutDir)\*Xbox*.pdb" />
    </ItemGroup>
    <Delete Files="@(_ATGShaderHeaders)" />
    <Delete Files="@(_ATGShaderSymbols)" />
    <PropertyGroup>
      <_ATGShaderOutDir />
    </PropertyGroup>
  </Target>
</Project>