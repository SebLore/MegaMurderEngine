<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_PropertySheetDisplayName>DebugBuildEvents</_PropertySheetDisplayName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>copy /Y "$(SolutionDir)external\FMod\core\lib\$(Platform)\fmodL.dll" "$(TargetDir)fmodL.dll" &amp;&amp; copy /Y "$(SolutionDir)external\FMod\studio\lib\$(Platform)\fmodstudioL.dll" "$(TargetDir)fmodstudioL.dll"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>